        <th colspan="2" style="width:92px;">Over Time</th>
        <th rowspan="2" style="width:50px;">Total<br/>Hour</th>
        <th rowspan="2" style="width:48px;">Total<br/>OT</th>
        <th rowspan="2" class="left">Activity / Remark</th>
